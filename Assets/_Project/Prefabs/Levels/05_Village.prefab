  requiredItem: {fileID: 11400000, guid: 896b5675e6ccebb408fec87d9b7f946a, type: 2}
  persistentStateId: {fileID: 7135466953274961201}
  beforeQuestDialogue:
    name: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 5"
    email: elder5
    recipientName: "\u0418\u0433\u0440\u043E\u043A"
    portrait: {fileID: 0}
    sentences:
    - "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043A \u043F\u043B\u0435\u043C\u0435\u043D\u0438
      \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0435\u0439,
      \u043D\u043E \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442."
    - "\u041D\u0430\u0439\u0434\u0438 \u043C\u043D\u0435 \u0442\u043E\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442."
  waitingDialogue:
    name: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 5"
    email: elder5
    recipientName: "\u0418\u0433\u0440\u043E\u043A"
    portrait: {fileID: 0}
    sentences:
    - "\u0411\u0435\u0437 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430
      \u044F \u043D\u0435 \u043E\u0442\u043A\u0440\u043E\u044E \u043F\u0443\u0442\u044C
      \u043A \u043C\u0438\u043D\u0438-\u0438\u0433\u0440\u0435."
  completedDialogue:
    name: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 5"
    email: elder5
    recipientName: "\u0418\u0433\u0440\u043E\u043A"
    portrait: {fileID: 0}
    sentences:
    - "\u0412\u043E\u0442 \u043E\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043C\u0438\u043D\u0438-\u0438\u0433\u0440\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430,
      \u043F\u0443\u0442\u044C \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C."
  afterCompletedDialogue:
    name: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 5"
    email: elder5
    recipientName: "\u0418\u0433\u0440\u043E\u043A"
    portrait: {fileID: 0}
    sentences:
    - "\u041C\u0438\u043D\u0438-\u0438\u0433\u0440\u0430 \u0443\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
  onCompleteActions: {fileID: 2794585402313099545}
