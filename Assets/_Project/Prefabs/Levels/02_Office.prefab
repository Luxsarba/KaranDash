  m_Script: {fileID: 11500000, guid: fba0c9e8bf77f904b963cda244714fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteTitle: "\u041E\u0444\u0438\u0441"
  noteSubtitle: "\u041A\u0432\u0435\u0441\u0442 \u043D\u0430 12 \u0443\u0431\u0438\u0439\u0441\u0442\u0432"
  noteText: "\u0417\u0434\u0435\u0441\u044C \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043D
    \u0440\u0430\u0431\u043E\u0447\u0438\u0439 kill-counter \u043D\u0430 12 \u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432.
    \u0414\u043B\u044F \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F AI \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439
    \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0432\u0441\u0451 \u0435\u0449\u0451
    \u043D\u0443\u0436\u0435\u043D baked NavMesh, \u043D\u043E objective \u0438 reward-\u043F\u0430\u0439\u043F\u043B\u0430\u0439\u043D
    \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u044B."
  backgroundSprite: {fileID: 0}
