  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 1"
    email: elder1
    recipientName: "\u0418\u0433\u0440\u043E\u043A"
    portrait: {fileID: 0}
    sentences:
    - "\u041E\u0445, \u044E\u043D\u044B\u0439 \u0434\u0440\u0443\u0433, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E,
      \u043A\u0430\u043A\u043E\u0439 \u043F\u0443\u0442\u044C \u0442\u0435\u0431\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043A\u0430\u0440\u0442\u0438\u043D\u0443."
    - "\u042F \u0431\u0443\u0434\u0443 \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C.
      \u0415\u0449\u0451 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F."
