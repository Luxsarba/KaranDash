  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fba0c9e8bf77f904b963cda244714fcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteTitle: "\u0413\u043E\u0440\u043E\u0434"
  noteSubtitle: "\u041F\u0430\u0442\u0442\u0435\u0440\u043D NPC+\u043D\u0430\u0433\u0440\u0430\u0434\u0430"
  noteText: "\u0420\u0430\u043C\u043A\u0430 \u0438 NPC, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u0440\u0430\u0437\u0443 \u043E\u0442\u0434\u0430\u044E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
    \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0437\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    hotspot-\u043E\u0431\u044A\u0435\u043A\u0442\u044B Talk/Reward. \u042D\u0442\u043E
    \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0442\u044C \u0441\u0446\u0435\u043D\u044B,
    \u0430 \u0442\u0435\u043A\u0443\u0449\u0435\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
    interaction path: \u0434\u043B\u044F \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0433\u043E
    authoring \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0435\u0448\u0430\u0442\u044C
    \u0438 \u0434\u0438\u0430\u043B\u043E\u0433, \u0438 reward \u043D\u0430 \u043E\u0434\u0438\u043D
    \u0438 \u0442\u043E\u0442 \u0436\u0435 hit-\u043E\u0431\u044A\u0435\u043A\u0442."
  backgroundSprite: {fileID: 0}
