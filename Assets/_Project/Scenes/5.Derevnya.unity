  dialogue:
    name: "\u041F\u0440\u043E\u0440\u043E\u043A"
    email: ' '
    recipientName: "\u041A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0443\u043B\u044C"
    portrait: {fileID: 0}
    sentences:
    - "\u041E\u043E\u043E. \u044D\u0442\u043E \u0436\u0443 \u0442\u044B."
    - "\u041C\u043D\u043E\u0433\u043E \u0436\u0435 \u043E \u0442\u0435\u0431\u0435
      \u043D\u0430\u0441\u043B\u044B\u0448\u0430\u043B \u0438 \u043C\u043D\u043E\u0433\u043E\u0435
      \u0432\u0438\u0434\u0435\u043B."
    - "\u042F \u0436\u0434\u0430\u043B \u043D\u0430\u0448\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    - "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0430\u0442\u0430"
