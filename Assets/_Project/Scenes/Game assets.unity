  m_Name: 
  m_EditorClassIdentifier: 
  noteTitle: Story Scaffold
  noteSubtitle: "\u041A\u0430\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C"
  noteText: "1. \u0412\u0441\u0435 scene transitions \u0441\u0435\u0439\u0447\u0430\u0441
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u044B \u043D\u0430 \u044D\u0442\u043E\u0442
    \u0436\u0435 scene 'Game assets' \u0438 \u0440\u0430\u0437\u043D\u044B\u0435
    SceneSpawnPoint \u2014 \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
    authoring scene.\n2. \u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0435
    \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u0446\u0435\u043D\u044B
    \u0443 trigger'\u043E\u0432 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
    targetSceneName/targetSpawnPointId.\n3. Dialogue + instant reward NPC \u0441\u0435\u0439\u0447\u0430\u0441
    \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0437\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    Talk/Reward hotspot'\u044B \u2014 \u044D\u0442\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u0435
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435 authoring-\u0440\u0435\u0448\u0435\u043D\u0438\u0435.\n4.
    Kill quest \u043D\u0430 12 \u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432,
    \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0440\u0430\u043C\u043A\u0430
    \u043D\u0430 6 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432 \u0438
    persistent world-state \u0434\u043B\u044F \u043C\u0438\u043D\u0438-\u0438\u0433\u0440
    \u0443\u0436\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u044B
    \u043A\u043E\u0434\u043E\u043C \u044D\u0442\u043E\u0439 \u0441\u0446\u0435\u043D\u044B.\n5.
    Combat section templates \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0440\u0435\u0431\u0443\u044E\u0442
    baked NavMesh \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u0446\u0435\u043D\u0430\u0445
    \u0434\u043B\u044F \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F AI.\n6. \u0414\u043B\u044F
    \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u043E\u043B\u0438\u043A\u0430
    \u0432 scaffold \u043D\u0443\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C VideoClip \u043D\u0430
    \u043E\u0431\u044A\u0435\u043A\u0442 FinalCutsceneOverlay."
  backgroundSprite: {fileID: 0}
